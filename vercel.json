{
  "version": 2,
  "buildCommand": "cd edtech-platform && npm run build",
  "outputDirectory": "edtech-platform/dist/edtech-platform/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matterhub.runasp.net/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
