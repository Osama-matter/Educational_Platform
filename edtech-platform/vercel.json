{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matterhub.runasp.net/api/:path*"
    },
    {
      "source": "/certification/:path*",
      "destination": "https://matterhub.runasp.net/certification/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://matterhub.runasp.net/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
